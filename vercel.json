{
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "includeFiles": "{index.html,data/**,ui/templates/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
